#include<LiquidCrystal.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);
int buttonpin = 9;
int val = 0, led_num = 0;
void setup()
{
 pinMode(9,INPUT); 
}

void loop()
{
   val = digitalRead(9);
    
  if (val == 1) {
    led_num = led_num + 1;
     if (led_num > 4) {
        led_num = 2;
     }
  }
  if(led_num == 1) {
lcd.begin(16, 2); 
  }
  
  else if (led_num == 2) {
  
  lcd.clear();
  lcd.setCursor(2, 0);
  lcd.print( "Hi");
  lcd. setCursor(2,1);
  lcd.print("Kim");
}
else if (led_num == 3) {
  lcd.clear();
  lcd.setCursor(2,0);
  lcd.print("I Love");
  lcd.setCursor(2,1);
  lcd.print("YOU");
}
else if (led_num == 4) {
  lcd.clear();
  lcd.setCursor(2,0);
  lcd.print("Happy");
  lcd.setCursor(2,1);
  lcd.print("Anniversary");
}
  else if (led_num == 5) {
    lcd.clear();
    lcd.noDisplay();
}

delay(300);
}
